<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- PC builds (Melon / BepInEx) target net6.0; Android targets net10.0 -->
		<TargetFramework Condition="'$(Configuration)' != 'Android'">net6.0</TargetFramework>
		<TargetFramework Condition="'$(Configuration)' == 'Android'">net10.0</TargetFramework>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<RootNamespace>Magnetar_Client</RootNamespace>
		<AssemblyName>Magnetar Client</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Configurations>melonloader;Release_Melon;Nightly_Melon;Bepinex;Release_bepinex;Android</Configurations>
	</PropertyGroup>

	<!-- Suppress higher-version framework conflict warnings across interop stubs -->
	<PropertyGroup Condition="'$(Configuration)' == 'Android'">
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<NoWarn>$(NoWarn);MSB3277;CS1701;CS1702</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<DefineConstants>$(Configuration)</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('Nightly')) or $(Configuration.Contains('nightly'))">
		<DefineConstants>$(DefineConstants);NIGHTLY</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('melon')) or $(Configuration.Contains('Melon'))">
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<DefineConstants>$(DefineConstants);MELONLOADER;RELEASE_MELON</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('Bepinex')) or $(Configuration.Contains('bepinex'))">
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<DefineConstants>$(DefineConstants);BEPINEX;RELEASE_BEPINEX</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Android'">
		<OutputPath>bin\Android\</OutputPath>
		<DefineConstants>$(DefineConstants);BEPINEX;RELEASE_BEPINEX</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);MSB3270;CS1591;CS1572</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<ItemDefinitionGroup>
		<Reference>
			<Private>false</Private>
		</Reference>
	</ItemDefinitionGroup>

	<PropertyGroup>
		<RefDir>$(MSBuildThisFileDirectory)..\References</RefDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<Reference Include="0Harmony">
			<HintPath>$(RefDir)\Melonloader\0Harmony.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!-- MelonLoader References -->
	<ItemGroup Condition="$(Configuration.Contains('melon')) or $(Configuration.Contains('Melon'))">
		<Reference Include="MelonLoader">
			<HintPath>$(RefDir)\Melonloader\MelonLoader.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppInterop.Common">
			<HintPath>$(RefDir)\Melonloader\Il2CppInterop.Common.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
			<HintPath>$(RefDir)\Melonloader\Il2CppInterop.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\Il2Cppmscorlib.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\Unity.TextMeshPro.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.AnimationModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.AnimationModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.AssetBundleModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.AssetBundleModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.IMGUIModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.InputLegacyModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.ParticleSystemModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.ParticleSystemModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.Physics2DModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.Physics2DModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.TextRenderingModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.UI.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.UIModule.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppUniTask">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\Il2CppUniTask.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(RefDir)\Melonloader\Il2Cpp\UnityEngine.ImageConversionModule.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!-- BepInEx References -->
	<ItemGroup Condition="$(Configuration.Contains('bepinex')) or $(Configuration.Contains('Bepinex')) or ('$(Configuration)' == 'Android')">
		<Reference Include="BepInEx.Core">
			<HintPath>$(RefDir)\Bepinex\BepInEx.Core.dll</HintPath>
		</Reference>
		<Reference Include="BepInEx.Unity.IL2CPP">
			<HintPath>$(RefDir)\Bepinex\BepInEx.Unity.IL2CPP.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
			<HintPath>$(RefDir)\Bepinex\Il2CppInterop.Runtime.dll</HintPath>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\Il2Cppmscorlib.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\Unity.TextMeshPro.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.AnimationModule">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.AnimationModule.dll</HintPath>
