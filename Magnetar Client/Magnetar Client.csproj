<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- PC builds (Melon / BepInEx) target net6.0; Android targets net10.0 -->
		<TargetFramework Condition="'$(Configuration)' != 'Android'">net6.0</TargetFramework>
		<TargetFramework Condition="'$(Configuration)' == 'Android'">net10.0</TargetFramework>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<RootNamespace>Magnetar_Client</RootNamespace>
		<AssemblyName>Magnetar Client</AssemblyName>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Configurations>melonloader;Release_Melon;Bepinex;Release_bepinex;Android</Configurations>
	</PropertyGroup>

	<!-- Suppress higher-version framework conflict warnings across interop stubs -->
	<PropertyGroup Condition="'$(Configuration)' == 'Android'">
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
		<NoWarn>$(NoWarn);MSB3277;CS1701;CS1702</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<DefineConstants>$(Configuration)</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('melon')) or $(Configuration.Contains('Melon'))">
		<OutputPath>bin\Melonloader\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('Bepinex')) or $(Configuration.Contains('bepinex'))">
		<OutputPath>bin\Bepinex\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Android'">
		<OutputPath>bin\Android\</OutputPath>
		<DefineConstants>$(DefineConstants);RELEASE_BEPINEX</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="References\**" />
		<EmbeddedResource Remove="References\**" />
		<None Remove="References\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<Reference Include="0Harmony">
			<HintPath>References\Melonloader\0Harmony.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!-- MelonLoader References -->
