		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.IMGUIModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.InputLegacyModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.ParticleSystemModule">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.ParticleSystemModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.Physics2DModule">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.Physics2DModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.TextRenderingModule">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.TextRenderingModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.UI.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UIModule">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.UIModule.dll</HintPath>
		</Reference>
		<Reference Include="UniTask">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UniTask.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(RefDir)\Bepinex\Il2Cpp\UnityEngine.ImageConversionModule.dll</HintPath>
		</Reference>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Condition="$(Configuration) == 'melonloader'" Command="copy /Y &quot;$(TargetDir)$(TargetFileName)&quot; &quot;C:\Users\Tproplay\Games\Pvz\Fusion RH\Melonloader 4.1\Mods\$(TargetFileName)&quot;&#xD;&#xA;start &quot;&quot; &quot;C:\Users\Tproplay\Games\Pvz\Fusion RH\Melonloader 4.1\PlantsVsZombiesRH.exe&quot;" />
		<Exec Condition="$(Configuration) == 'Bepinex'" Command="copy /Y &quot;$(TargetDir)$(TargetFileName)&quot; &quot;C:\Users\Tproplay\Games\Pvz\Fusion RH\BepInEx 4.1\BepInEx\plugins\$(TargetFileName)&quot;&#xD;&#xA;start &quot;&quot; &quot;C:\Users\Tproplay\Games\Pvz\Fusion RH\BepInEx 4.1\PlantsVsZombiesRH.exe&quot;" />
	</Target>

	<ItemGroup>
	  <EditorConfigFiles Remove="C:\Users\Tproplay\Desktop\Visual studio\Magnetar Client\Magnetar Client\.editorconfig" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="C:\Users\Tproplay\Desktop\Visual studio\Magnetar Client\Magnetar Client\.editorconfig" />
	</ItemGroup>

</Project>